      "name": "FloatTensor.java",
      "filePath": "src/com/llama4j/FloatTensor.java",
      "summary": "Abstract base class for all tensor types in the LLM inference engine, providing core tensor operations (dot, matmul, softmax, RMSNorm helpers, reductions) with SIMD vector API acceleration",
      "tags": ["tensor", "base-class", "linear-algebra", "simd"],
      "complexity": "complex"
    },
    {
      "id": "class:src/com/llama4j/FloatTensor.java:FloatTensor",
      "type": "class",
      "name": "FloatTensor",
      "filePath": "src/com/llama4j/FloatTensor.java",
      "lineRange": [33, 239],
      "summary": "Abstract base class for float tensor types. Defines the tensor algebra interface: dot product, matrix multiply, reductions (sum/max/argmax), in-place operations (add/multiply/divide/fill/softmax/saxpy), and utility methods. Uses Java Vector API and sun.misc.Unsafe for memory access.",
      "tags": ["tensor", "abstract", "linear-algebra", "simd", "vector-api"],
      "complexity": "complex"
    },
    {
      "id": "function:src/com/llama4j/FloatTensor.java:argmax",
      "type": "function",
      "name": "argmax",
      "filePath": "src/com/llama4j/FloatTensor.java",
      "lineRange": [149, 162],
      "summary": "Finds the index of the maximum value in a tensor slice. Used by Sampler.ARGMAX for greedy token selection.",
      "tags": ["reduction", "sampling", "argmax"],
      "complexity": "simple"
    },
    {
      "id": "file:src/com/llama4j/ArrayFloatTensor.java",
      "type": "file",
      "name": "ArrayFloatTensor.java",
      "filePath": "src/com/llama4j/ArrayFloatTensor.java",
      "summary": "Float tensor backed by a plain Java float array with full read/write support, used for KV cache and activation buffers",
      "tags": ["tensor", "array-backed", "cpu"],
      "complexity": "moderate"
    },
    {
      "id": "class:src/com/llama4j/ArrayFloatTensor.java:ArrayFloatTensor",
      "type": "class",
