      "tags": ["tensor", "quantized", "fp16", "simd"],
      "complexity": "complex"
    },
    {
      "id": "class:src/com/llama4j/F16FloatTensor.java:F16FloatTensor",
      "type": "class",
      "name": "F16FloatTensor",
      "filePath": "src/com/llama4j/F16FloatTensor.java",
      "lineRange": [31, 124],
      "summary": "FP16 quantized float tensor. Converts float16 bits stored as shorts to float32 using manual exponent/mantissa manipulation. Implements fast vectorized dot product with software float16 decode and FMA accumulation.",
      "tags": ["tensor", "quantized", "fp16", "simd", "memory-segment"],
      "complexity": "complex"
    },
    {
      "id": "function:src/com/llama4j/F16FloatTensor.java:vectorDot",
      "type": "function",
      "name": "vectorDot",
      "filePath": "src/com/llama4j/F16FloatTensor.java",
      "lineRange": [75, 123],
      "summary": "SIMD-accelerated dot product for FP16 tensors. Manually decodes float16 bit-representation to float32 in vector registers, then FMA-accumulates. Handles denormals, infinities, and NaN per IEEE 754-2008.",
      "tags": ["simd", "dot-product", "fp16", "vector-api", "ieee754"],
      "complexity": "complex"
    },
