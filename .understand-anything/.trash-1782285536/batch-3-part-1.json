      "filePath": "src/com/llama4j/ArrayFloatTensor.java",
      "lineRange": [23, 70],
      "summary": "Float tensor backed by float[] array. Supports get/set/fill and SIMD getFloatVector. Used for KV cache and state buffers where random access writes are needed.",
      "tags": ["tensor", "array-backed", "float-array"],
      "complexity": "moderate"
    },
    {
      "id": "file:src/com/llama4j/BF16FloatTensor.java",
