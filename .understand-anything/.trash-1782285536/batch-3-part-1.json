      "name": "BF16FloatTensor.java",
      "filePath": "src/com/llama4j/BF16FloatTensor.java",
      "summary": "BF16 (bfloat16) quantized tensor with vectorized dot product using SIMD short-to-float conversion",
      "tags": ["tensor", "quantized", "bf16", "simd"],
      "complexity": "complex"
    },
    {
      "id": "class:src/com/llama4j/BF16FloatTensor.java:BF16FloatTensor",
      "type": "class",
      "name": "BF16FloatTensor",
      "filePath": "src/com/llama4j/BF16FloatTensor.java",
      "lineRange": [31, 112],
      "summary": "BF16 quantized float tensor backed by MemorySegment. Implements vectorized dot product by loading shorts, converting bf16→float via left-shift and reinterpret, then FMA-accumulating. SetFloat and getFloatVector throw UnsupportedOperationException.",
      "tags": ["tensor", "quantized", "bf16", "simd", "memory-segment"],
      "complexity": "complex"
    },
    {
      "id": "function:src/com/llama4j/BF16FloatTensor.java:vectorDot",
      "type": "function",
      "name": "vectorDot",
      "filePath": "src/com/llama4j/BF16FloatTensor.java",
      "lineRange": [80, 110],
      "summary": "SIMD-accelerated dot product for BF16 tensors. Loads short vectors, casts to int, left-shifts 16 bits, reinterprets as float, and FMA-accumulates against the other tensor's float vector.",
      "tags": ["simd", "dot-product", "bf16", "vector-api"],
      "complexity": "complex"
    },
    {
      "id": "file:src/com/llama4j/F16FloatTensor.java",
